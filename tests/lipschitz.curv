// The fields are 1-Lipschitz: abs(f p - f q) <= mag(p - q) for all p, q.
// This is the condition for safe sphere tracing, and it makes abs(f p) a
// lower bound on the distance to the surface.
let
    S = file "support.curv";
    G = file "../gear.curv";

    polar p = [mag p, phase p];
    rot [a, p] = cmul[p, cis a];

    within [fp, fq, p, q] = abs(fp - fq) <= mag(p - q)*(1 + 1e-9) + 1e-12;

    // Separations, in modules, used in turn for the random pairs.
    steps = [1e-4, 1e-2, 0.3, 2.5];

    unit2 i = cis(tau*S.rand i);
    unit3 i = normalize(2*[S.rand i, S.rand(i + 1), S.rand(i + 2)] - 1 + [1e-3, 0, 0]);

    // 2D pairs for a polar field f of gear g.
    check_field [name, g, f] =
        do
            // Random pairs over the whole gear and some space around it.
            for (i in 0..399)
                let p = (2*[S.rand(3*i), S.rand(3*i + 1)] - 1)*1.3*g.ra;
                    q = p + steps.[mod[i, 4]]*g.m*unit2(3*i + 2);
                in exec(S.check [within [f p, f q, p, q],
                    "$(name): pair $(p) $(q): $(f p) and $(f q)"]);

            // Pairs across the fold lines: tooth centres and gap centres.
            for (k in 0..<g.z)
                for (a in [k*tau/g.z, (k + 0.5)*tau/g.z])
                    for (r in [0.5*g.rf, g.rf, (g.rf + g.rb)/2, g.rb, g.rp, g.ra, 1.1*g.ra])
                        for (da in [1e-6, 1e-3, 0.05])
                            let p = rot[a - da, [r, 0]];
                                q = rot[a + da, [r, 0]];
                            in exec(S.check [within [f p, f q, p, q],
                                "$(name): fold pair at angle $(a) radius $(r): $(f p) and $(f q)"]);

            // Pairs across the base circle, near the flank.
            for (k in 0..40)
                let a = g.psi_b*(0.5 + k/20);
                    p = rot[a, [g.rb*(1 - 1e-3), 0]];
                    q = rot[a + 1e-4, [g.rb*(1 + 1e-3), 0]];
                in exec(S.check [within [f p, f q, p, q],
                    "$(name): base-circle pair at angle $(a): $(f p) and $(f q)"]);
        in #true;

    gears = [
        G.spur {m: 1, z: 18},
        G.spur {m: 2, z: 47, backlash: 0.1},
        G.spur {m: 0.8, z: 60, backlash: 0.1},
        G.spur {m: 1.5, z: 30, backlash: 0.15},
    ];

    pg = G.place {
        gear: gears.[3],
        centre: [4, 1],
        angle: t -> 0.7*t,
        z0: -2,
        width: 6,
        bore: 5,
    };
    prof = G.profile pg;
    body = G.body pg;
in do
    for (g in gears)
        exec(check_field ["field m=$(g.m) z=$(g.z)", g, p -> g.field(polar p)]);

    exec(check_field ["profile", gears.[3],
        p -> prof.dist[p.[X] + 4, p.[Y] + 1, 0, 0]]);

    // 3D pairs for the body, at random times.
    for (i in 0..599)
        let b = body.bbox;
            lo = b.[MIN] - 2;
            hi = b.[MAX] + 2;
            p = lo + (hi - lo)*[S.rand(7*i), S.rand(7*i + 1), S.rand(7*i + 2)];
            q = p + steps.[mod[i, 4]]*pg.gear.m*unit3(7*i + 3);
            time = 10*S.rand(7*i + 6);
            fp = body.dist[p.[X], p.[Y], p.[Z], time];
            fq = body.dist[q.[X], q.[Y], q.[Z], time];
        in exec(S.check [within [fp, fq, p, q],
            "body: pair $(p) $(q) at time $(time): $(fp) and $(fq)"]);

    // 3D pairs across the bore wall, the hub, the hole ring and the faces.
    for (k in 0..59)
        let a = k*tau/60;
            time = 0.37*k;
            z = pg.z0 + pg.width*(k/59);
        in for (r in [pg.bore/2, pg.hub, pg.hole_ring - pg.hole_d/2,
                      pg.hole_ring, pg.hole_ring + pg.hole_d/2, pg.rim])
            let p = [...(pg.centre + rot[a, [r - 1e-3, 0]]), z];
                q = [...(pg.centre + rot[a + 1e-3, [r + 1e-3, 0]]), z + 1e-3];
                fp = body.dist[p.[X], p.[Y], p.[Z], time];
                fq = body.dist[q.[X], q.[Y], q.[Z], time];
            in exec(S.check [within [fp, fq, p, q],
                "body: wall pair at radius $(r) angle $(a): $(fp) and $(fq)"]);
in #true
