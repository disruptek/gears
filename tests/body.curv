// The 3D body: bore, hub, rim, lightening holes, faces and bounding box.
let
    S = file "support.curv";
    G = file "../gear.curv";

    rot [a, p] = cmul[p, cis a];

    // Expected derived fields, from the README formulas.
    derived [g, bore] =
        let hub = bore/2 + 1.5*g.m;
            rim = g.rf - 2*g.m;
            ring = (hub + rim)/2;
        in [hub, rim, ring, max[0, min[0.85*(rim - hub), 0.7*ring]]];

    cases = [
        // Large gear: room for holes.
        {gear: G.spur {m: 2, z: 40, backlash: 0.1}, centre: [5, 7],
         spin: 0.2, z0: 3, width: 8, bore: 6},
        // Small gear with a big bore: the hub reaches the rim, so no holes.
        {gear: G.spur {m: 1, z: 18}, centre: [-4, 2],
         spin: -0.5, z0: -1, width: 2, bore: 10},
    ];

    check_case c =
        let pg = G.place {
                gear: c.gear,
                centre: c.centre,
                angle: t -> c.spin*t,
                z0: c.z0,
                width: c.width,
                bore: c.bore,
            };
            body = G.body pg;
            g = c.gear;
            [hub, rim, ring, hole_d] = derived [g, c.bore];
            name = "body m=$(g.m) z=$(g.z) bore=$(c.bore)";
            tol = 1e-9*g.m;
            zmid = c.z0 + c.width/2;
            // Field at gear-frame point [x, y], height z, time t.
            at [x, y, z, t] =
                let w = c.centre + rot[pg.angle t, [x, y]];
                in body.dist[w.[X], w.[Y], z, t];
            times = [0, 1.3, 7.7];
        in do
            exec(S.check [
                and [S.near [pg.hub, hub, tol], S.near [pg.rim, rim, tol],
                     S.near [pg.hole_ring, ring, tol], S.near [pg.hole_d, hole_d, tol]],
                "$(name): derived fields $([pg.hub, pg.rim, pg.hole_ring, pg.hole_d])"]);

            for (t in times)
                for (k in 0..23)
                    let a = k*tau/24;
                    in do
                        // The bore is empty.
                        for (r in [0, c.bore/4, c.bore/2*0.98])
                            exec(S.check [at[...(r*cis a), zmid, t] > 0,
                                "$(name): bore point r=$(r) a=$(a) t=$(t) is solid"]);
                        // The hub is solid.
                        for (r in [c.bore/2*1.02 + 1e-3, (c.bore/2 + hub)/2, hub*0.99])
                            exec(S.check [at[...(r*cis a), zmid, t] < 0,
                                "$(name): hub point r=$(r) a=$(a) t=$(t) is empty"]);
                        // The rim is solid, including under the tooth gaps.
                        for (r in [rim*1.005, (rim + g.rf)/2, g.rf*0.99])
                            exec(S.check [at[...(r*cis a), zmid, t] < 0,
                                "$(name): rim point r=$(r) a=$(a) t=$(t) is empty"]);
                    in #true;

            // The holes: empty at their centres when hole_d > 0.
            // Without holes, the hole ring is solid.
            for (t in times)
                for (k in 0..5)
                    let v = at[...(ring*cis(k*tau/6)), zmid, t];
                    in exec(S.check [if (hole_d > 0) v > 0 else v < 0,
                        "$(name): hole $(k) at time $(t): field $(v)"]);

            // The faces: solid just inside, empty just outside.
            for (z in [c.z0 + 1e-3, c.z0 + c.width - 1e-3])
                exec(S.check [at[(hub + c.bore/2)/2, 0, z, 0] < 0,
                    "$(name): the body is empty at z=$(z)"]);
            for (z in [c.z0 - 1e-3, c.z0 + c.width + 1e-3])
                exec(S.check [at[(hub + c.bore/2)/2, 0, z, 0] > 0,
                    "$(name): the body is solid at z=$(z)"]);

            // The bounding box is the tip-circle square times the layer.
            exec(S.check [
                and [mag(body.bbox.[MIN] - [c.centre.[X] - g.ra, c.centre.[Y] - g.ra, c.z0]) < tol,
                     mag(body.bbox.[MAX] - [c.centre.[X] + g.ra, c.centre.[Y] + g.ra, c.z0 + c.width]) < tol],
                "$(name): bbox $(body.bbox)"]);
            exec(S.check [body.is_3d && not(body.is_2d), "$(name): the body is not 3D"]);

            // No solid point lies outside the bounding box.
            for (i in 0..999)
                let lo = body.bbox.[MIN] - 3;
                    hi = body.bbox.[MAX] + 3;
                    p = lo + (hi - lo)*[S.rand(5*i), S.rand(5*i + 1), S.rand(5*i + 2)];
                    t = 9*S.rand(5*i + 3);
                    inside = body.dist[p.[X], p.[Y], p.[Z], t] <= 0;
                    in_box = and (p >= body.bbox.[MIN]) && and (p <= body.bbox.[MAX]);
                in exec(S.check [not inside || in_box,
                    "$(name): solid point $(p) at time $(t) is outside the bbox"]);
        in #true;
in do
    for (c in cases) exec(check_case c);
in #true
