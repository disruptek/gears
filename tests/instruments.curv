// Check the measuring helpers in support.curv against cases with known
// answers, so that a failure elsewhere is not an instrument error.
let
    S = file "support.curv";

    disc [c, r] p = mag(p - c) - r;
    // A field with the same zero set that understates the distance by k.
    understate k f p = (f p)/k;

    // Two unit circles at centre distance d, direction dir, with fields
    // that understate by ka and kb.
    gap [d, dir, ka, kb] =
        let cb = d*cis dir;
        in S.clearance {
            fa: understate ka (disc [[0, 0], 1]),
            fb: understate kb (disc [cb, 1]),
            ca: [0, 0],
            cb: cb,
            ra_a: 1.3,
            ra_b: 1.3,
            m: 0.2,
        };

    // [d, dir, ka, kb, expected clearance]
    cases = [
        [2.5,  0,    1,    1,    0.5],
        [2.5,  1.1,  1,    1,    0.5],
        [2.04, -2.3, 1,    1,    0.04],
        [1.7,  0.4,  1,    1,    -0.3],
        // Understating fields: each side reports its own scaled value.
        [2.5,  0.3,  1.02, 1.05, 0.5/1.05],
        [1.7,  2.9,  1.02, 1.05, -0.3/1.02],
    ];
in do
    for (a in [0, 0.7, -2.1, 3])
        let p = S.boundary_point [disc [[0, 0], 1], [0, 0], a, 0.5, 1.5];
        in exec(S.check [S.near [mag p, 1, 1e-12] && mag(p - cis a) < 1e-12,
            "boundary_point at angle $(a): $(p)"]);
    for (c in cases)
        let g = gap [c.[0], c.[1], c.[2], c.[3]];
        in exec(S.check [S.near [g, c.[4], 1e-9],
            "clearance for $(c): $(g), expected $(c.[4])"]);
    exec(S.check [S.rand 3 >= 0 && S.rand 3 < 1 && S.rand 3 != S.rand 4,
        "rand: values out of range or repeated"]);
in #true
