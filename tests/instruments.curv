// Check the measuring helpers in support.curv against cases with known
// answers, so that a failure elsewhere is not an instrument error.
let
    S = file "support.curv";

    disc [c, r] p = mag(p - c) - r;

    bowl [x, y] = (x - 0.3)^2 + (y + 0.2)^2 + 1;
    found = S.minimize {
        f: bowl,
        box: [[-1, -1], [1, 1]],
        h: 0.125,
        tol: 1e-7,
        seeds: 2,
    };

    // Two unit circles at centre distance d have clearance d - 2.
    gap [d, dir] =
        let cb = d*cis dir;
        in S.clearance {
            fa: disc [[0, 0], 1],
            fb: disc [cb, 1],
            ca: [0, 0],
            cb: cb,
            ra_a: 1.3,
            ra_b: 1.3,
            m: 0.2,
        };
in do
    exec(S.check [S.near [found.[0], 1, 1e-10],
        "minimize: value $(found.[0]), expected 1"]);
    exec(S.check [mag(found.[1] - [0.3, -0.2]) < 1e-5,
        "minimize: point $(found.[1]), expected [0.3,-0.2]"]);
    for (case in [[2.5, 0], [2.5, 1.1], [2.04, -2.3], [1.7, 0.4]])
        let g = gap case;
        in exec(S.check [S.near [g, case.[0] - 2, 1e-9],
            "clearance at $(case): $(g), expected $(case.[0] - 2)"]);
    exec(S.check [S.rand 3 >= 0 && S.rand 3 < 1 && S.rand 3 != S.rand 4,
        "rand: values out of range or repeated"]);
in #true
